<Project Sdk="Microsoft.NET.Sdk">
  <!-- Build: dotnet build -c Release -p:MelonLoaderDir=<folder with MelonLoader/net6/MelonLoader.dll>
       (a BTD6 install with MelonLoader, or an extracted MelonLoader release). Output: RRBTD6Installer.dll -->
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <LangVersion>10</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>RRBTD6Installer</AssemblyName>
    <RootNamespace>RRBTD6Installer</RootNamespace>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="MelonLoader">
      <HintPath>$(MelonLoaderDir)/MelonLoader/net6/MelonLoader.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
