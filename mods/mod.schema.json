{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RustTD6 mod API 1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "api_version",
    "id",
    "name",
    "version"
  ],
  "properties": {
    "api_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32
    },
    "description": {
      "type": "string",
      "maxLength": 1024
    },
    "on_new_sandbox": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "starting_cash": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 1000000000000
        },
        "starting_lives": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 1000000000
        }
      }
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "starting_cash": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "min",
            "max",
            "step"
          ],
          "properties": {
            "min": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000000000
            },
            "max": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000000000
            },
            "step": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000000000
            }
          }
        },
        "starting_lives": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "min",
            "max",
            "step"
          ],
          "properties": {
            "min": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000000
            },
            "max": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000000
            },
            "step": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000000
            }
          }
        }
      }
    },
    "content": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "op",
              "id",
              "base"
            ],
            "properties": {
              "op": {
                "const": "tower"
              },
              "id": {
                "type": "string"
              },
              "base": {
                "type": "string"
              },
              "patch": {
                "type": [
                  "object",
                  "null"
                ]
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "op",
              "id",
              "base"
            ],
            "properties": {
              "op": {
                "const": "bloon"
              },
              "id": {
                "type": "string"
              },
              "base": {
                "type": "string"
              },
              "patch": {
                "type": [
                  "object",
                  "null"
                ]
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "op",
              "id",
              "base"
            ],
            "properties": {
              "op": {
                "const": "mode"
              },
              "id": {
                "type": "string"
              },
              "base": {
                "type": "string"
              },
              "patch": {
                "type": [
                  "object",
                  "null"
                ]
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "op",
              "path",
              "value"
            ],
            "properties": {
              "op": {
                "const": "set"
              },
              "path": {
                "type": "string"
              },
              "value": {}
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "op",
              "patch"
            ],
            "properties": {
              "op": {
                "const": "all_modes"
              },
              "patch": {
                "type": "object"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "op",
              "page",
              "path"
            ],
            "properties": {
              "op": {
                "const": "menu"
              },
              "page": {
                "type": "string"
              },
              "path": {
                "type": "string"
              },
              "text": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "visible": {
                "type": [
                  "boolean",
                  "null"
                ]
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "op",
              "from",
              "path"
            ],
            "properties": {
              "op": {
                "const": "copy"
              },
              "from": {
                "type": "string"
              },
              "path": {
                "type": "string"
              }
            }
          }
        ]
      }
    }
  }
}
