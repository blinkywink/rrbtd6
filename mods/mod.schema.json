{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RustTD6 mod API 1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "api_version",
    "id",
    "name",
    "version"
  ],
  "properties": {
    "api_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32
    },
    "description": {
      "type": "string",
      "maxLength": 1024
    },
    "on_new_sandbox": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "starting_cash": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 1000000000000
        },
        "starting_lives": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 1000000000
        }
      }
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "starting_cash": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "min",
            "max",
            "step"
          ],
          "properties": {
            "min": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000000000
            },
            "max": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000000000
            },
            "step": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000000000
            }
          }
        },
        "starting_lives": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "min",
            "max",
            "step"
          ],
          "properties": {
            "min": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000000
            },
            "max": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000000
            },
            "step": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000000
            }
          }
        }
      }
    },
    "content": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "op",
              "id",
              "base"
            ],
            "properties": {
              "op": {
                "const": "tower"
              },
              "id": {
                "type": "string"
              },
              "base": {
                "type": "string"
              },
              "patch": {
                "type": [
                  "object",
                  "null"
                ]
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "op",
              "id",
              "base"
            ],
            "properties": {
              "op": {
                "const": "bloon"
              },
              "id": {
                "type": "string"
              },
              "base": {
                "type": "string"
              },
              "patch": {
                "type": [
                  "object",
                  "null"
                ]
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "op",
              "id",
              "base"
            ],
            "properties": {
              "op": {
                "const": "mode"
              },
              "id": {
                "type": "string"
              },
              "base": {
                "type": "string"
              },
              "patch": {
                "type": [
                  "object",
                  "null"
                ]
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "op",
              "path",
              "value"
            ],
            "properties": {
              "op": {
                "const": "set"
              },
              "path": {
                "type": "string"
              },
              "value": {}
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "op",
              "patch"
            ],
            "properties": {
              "op": {
                "const": "all_modes"
              },
              "patch": {
                "type": "object"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "op",
              "page",
              "path"
            ],
            "properties": {
              "op": {
                "const": "menu"
              },
              "page": {
                "type": "string"
              },
              "path": {
                "type": "string"
              },
              "text": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "visible": {
                "type": [
                  "boolean",
                  "null"
                ]
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "op",
              "from",
              "path"
            ],
            "properties": {
              "op": {
                "const": "copy"
              },
              "from": {
                "type": "string"
              },
              "path": {
                "type": "string"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "op",
              "tower",
              "asset",
              "muzzle",
              "release"
            ],
            "properties": {
              "op": {
                "const": "tower_model"
              },
              "tower": {
                "type": "string"
              },
              "asset": {
                "type": "string",
                "pattern": "^mod:[A-Za-z0-9_-]+/[A-Za-z0-9_-]+$"
              },
              "muzzle": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": {
                  "type": "number"
                }
              },
              "release": {
                "type": "number",
                "minimum": 0,
                "maximum": 5
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "op",
              "tower",
              "path",
              "tier"
            ],
            "properties": {
              "op": {
                "const": "upgrade_patch"
              },
              "tower": {
                "type": "string"
              },
              "path": {
                "type": "integer",
                "minimum": 0,
                "maximum": 2
              },
              "tier": {
                "type": "integer",
                "minimum": 1,
                "maximum": 5
              },
              "cost": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              },
              "stats": {
                "type": [
                  "object",
                  "null"
                ]
              },
              "weapon": {
                "type": [
                  "object",
                  "null"
                ]
              },
              "projectile": {
                "type": [
                  "object",
                  "null"
                ]
              },
              "model": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "muzzle": {
                "type": [
                  "array",
                  "null"
                ],
                "minItems": 3,
                "maxItems": 3,
                "items": {
                  "type": "number"
                }
              },
              "release": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "maximum": 5
              },
              "projectile_from": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "op",
              "id",
              "source"
            ],
            "properties": {
              "op": {
                "const": "script"
              },
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "source": {
                "type": "string",
                "maxLength": 32768
              },
              "tick_interval": {
                "type": "integer",
                "minimum": 1,
                "maximum": 3600
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "op",
              "tower"
            ],
            "properties": {
              "op": {
                "const": "shop"
              },
              "tower": {
                "type": "string"
              },
              "before": {
                "type": "string"
              },
              "after": {
                "type": "string"
              },
              "index": {
                "type": "integer",
                "minimum": 0,
                "maximum": 512
              },
              "visible": {
                "type": "boolean"
              },
              "category": {
                "enum": [
                  1,
                  2,
                  4,
                  8
                ]
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "op",
              "path",
              "index",
              "value"
            ],
            "properties": {
              "op": {
                "const": "insert"
              },
              "path": {
                "type": "string",
                "maxLength": 512
              },
              "index": {
                "type": "integer",
                "minimum": 0
              },
              "value": {}
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "op",
              "path",
              "index"
            ],
            "properties": {
              "op": {
                "const": "remove"
              },
              "path": {
                "type": "string",
                "maxLength": 512
              },
              "index": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        ]
      }
    }
  }
}
