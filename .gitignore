/target/
# Proprietary game data extracted locally for analysis. Never commit or redistribute.
/local_extracted/
# Dumps derived from the game's binaries (symbol/type listings). Local only.
/research/dumps/
# Third-party repositories cloned for review.
/tools/external/
__pycache__/
/tools/.venv/
# The one playable build (tools/build_exe.sh).
/BTD6.exe
# Installed local mods are user content; keep only the shipped API docs and example.
/mods/*
!/mods/README.md
!/mods/mod.schema.json
!/mods/practice-start/
/mods/practice-start/*
!/mods/practice-start/mod.json
