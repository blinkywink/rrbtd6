/target/
# Proprietary game data extracted locally for analysis. Never commit or redistribute.
/local_extracted/
# Dumps derived from the game's binaries (symbol/type listings). Local only.
/research/dumps/
# Third-party repositories cloned for review.
/tools/external/
__pycache__/
/tools/.venv/
# The one playable build (tools/build_exe.sh).
/BTD6.exe
# The macOS build (tools/build_macos.sh).
/RustTD6.app/
# The personal iOS build (tools/build_ios.sh): it holds game data, so it's never published.
/RustTD6.ipa
# The Linux build (tools/build_linux.sh).
/RustTD6-linux
# Installed local mods are user content; keep only the shipped API docs and example.
/mods/*
!/mods/README.md
!/mods/mod.schema.json
!/mods/practice-start/
/mods/practice-start/*
!/mods/practice-start/mod.json

# The jukebox's player music folder (renderer/src/jukebox.rs).
/Custom Music/

# JVM crash dumps (Ghidra) and local session settings.
hs_err_pid*.log
replay_pid*.log
/.claude/

.claude/settings.local.json
.claude/STOP_KEEP_GOING
.claude/keep_going_wait
website/text_edits.json
